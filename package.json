{
  "name": "ctn-backend",
  "version": "1.0.0",
  "description": "Lean backend setup",
  "type": "commonjs",
  "packageManager": "npm@11.10.1",
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=11.10.1"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "start:prod": "cross-env NODE_ENV=production node dist/index.js",
    "start:dev": "cross-env NODE_ENV=development ts-node src/index.ts",
    "dev": "nodemon --watch src --watch .env --ext ts --exec ts-node src/index.ts",
    "test": "jest --passWithNoTests",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "db:clean": "ts-node src/scripts/cleanup.ts",
    "db:ensure-indexes": "ts-node src/scripts/ensureIndexes.ts",
    "db:migrate-marketplace": "ts-node src/scripts/migrateMarketplaceCategories.ts",
    "db:migrate-referrals": "ts-node src/scripts/migrateUserReferralCodes.ts",
    "db:migrate-purchased": "ts-node src/scripts/migrateMembersToPurchased.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@bull-board/api": "^5.23.0",
    "@bull-board/express": "^5.23.0",
    "@types/pdfkit": "^0.17.6",
    "axios": "^1.15.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^8.6.2",
    "geoip-lite": "^1.2.2",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.3.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.5.0",
    "morgan": "^1.10.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.20.2",
    "rate-limit-redis": "^6.0.1",
    "razorpay": "^2.9.6",
    "reflect-metadata": "^0.2.2",
    "request-ip": "^3.3.0",
    "routing-controllers": "^0.11.3",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.31",
    "ua-parser-js": "^2.0.9"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-fileupload": "^1.5.1",
    "@types/geoip-lite": "^1.4.4",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.11.30",
    "@types/nodemailer": "^6.4.14",
    "@types/request-ip": "^0.0.41",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.9.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
